<?xml version="1.0" encoding="UTF-8"?>
<actions>
    <action>
        <actionName>run</actionName>
        <packagings><packaging>jar</packaging></packagings>
        <goals><goal>spring-boot:run</goal></goals>
    </action>
    <action>
        <actionName>debug</actionName>
        <packagings><packaging>jar</packaging></packagings>
        <goals><goal>spring-boot:run</goal></goals>
        <properties>
            <jpda.listen>true</jpda.listen>
            <spring-boot.run.jvmArguments>-Xdebug -Xrunjdwp:transport=dt_socket,server=n,address=${jpda.address}</spring-boot.run.jvmArguments>
        </properties>
    </action>
    <action>
        <actionName>CUSTOM-run-h2</actionName>
        <displayName>run (perfil H2, sem MySQL)</displayName>
        <goals><goal>spring-boot:run</goal></goals>
        <properties>
            <spring-boot.run.profiles>h2</spring-boot.run.profiles>
        </properties>
    </action>
</actions>
